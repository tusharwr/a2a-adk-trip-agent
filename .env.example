# LLM Configuration
# For OpenAI: OPENAI_API_KEY=sk-... | OPENAI_MODEL=openai/gpt-4o-mini
# For Ollama: OPENAI_API_KEY=ollama | OPENAI_MODEL=ollama/qwen2.5:1.5b
# For other litellm providers, see: https://docs.litellm.ai/docs/providers
OPENAI_API_KEY=ollama
OPENAI_MODEL=ollama/qwen2.5:1.5b

TRIP_AGENT_HOST=127.0.0.1

DRIVER_PORT=8000
HOTEL_PORT=8001
FLIGHT_PORT=8002
ACTIVITIES_PORT=8003

HOTEL_AGENT_CARD_URL=http://127.0.0.1:8001/.well-known/agent-card.json
FLIGHT_AGENT_CARD_URL=http://127.0.0.1:8002/.well-known/agent-card.json
ACTIVITIES_AGENT_CARD_URL=http://127.0.0.1:8003/.well-known/agent-card.json
